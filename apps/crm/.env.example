# Which client this CRM serves. In production it is read from the first part of the
# host name (e.g. "sri-gold" in sri-gold.crm.example.com); set it here for local work.
VITE_TENANT_SLUG=demo

# Base path of the API. Leave as /api/v1 when the API is served from the same host.
VITE_API_BASE_URL=/api/v1

# Where `npm run dev` forwards /api requests.
VITE_API_PROXY_TARGET=http://localhost:8000
