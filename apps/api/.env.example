# Copy to .env for local runs outside Docker. All settings use the DG_ prefix.
DG_ENV=dev
DG_DATABASE_URL=postgresql+asyncpg://digigold:digigold@localhost:5432/digigold
DG_JWT_SECRET=replace-with-a-long-random-string
DG_EMAIL_BACKEND=smtp
DG_SMTP_HOST=localhost
DG_SMTP_PORT=1025
DG_EMAIL_FROM=no-reply@digigold.local
DG_EMAIL_FROM_NAME=Digi Gold
# For hosts that block SMTP (Render free plan): DG_EMAIL_BACKEND=brevo plus an API key.
# DG_BREVO_API_KEY=
DG_CRM_BASE_URL=http://localhost:5173
DG_CONSOLE_BASE_URL=http://localhost:5174
