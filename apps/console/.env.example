# Base path of the API. Leave as /api/v1 when the API is served from the same host.
VITE_API_BASE_URL=/api/v1

# Where `npm run dev` forwards /api and /media requests.
VITE_API_PROXY_TARGET=http://localhost:8000

# Address of a client's CRM, used for "Open CRM" links. {slug} is replaced.
VITE_CRM_URL_TEMPLATE=http://localhost:5173
