{
  "name": "@digigold/web-common",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Inputs, UI pieces, formatting and hooks shared by the CRM and the Platform Console. Consumed as TypeScript source; each app's Vite build compiles it.",
  "exports": {
    "./api/schema": {
      "types": "./src/api/schema.d.ts"
    },
    "./*": "./src/*"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "api:types": "npx -y openapi-typescript@7.13.0 ../../apps/api/openapi.json -o src/api/schema.d.ts"
  },
  "peerDependencies": {
    "@ant-design/icons": "^6.3.4",
    "@reduxjs/toolkit": "^2.12.0",
    "antd": "^6.6.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0"
  }
}
