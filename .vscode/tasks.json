{
  // Starts every Digi Gold system in its own terminal when the folder opens.
  // Postgres (port 5433) must already be running: C:\Freelancing-project\start-digi-gold.ps1 starts it.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "API 8000",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\uvicorn.exe app.main:app --reload --host 0.0.0.0 --port 8000",
      "options": { "cwd": "${workspaceFolder}/apps/api" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "digi" }
    },
    {
      "label": "Console 5174",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/apps/console" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "digi" }
    },
    {
      "label": "CRM 5173",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/apps/crm" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "digi" }
    },
    {
      "label": "Website 5175",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/apps/website" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "digi" }
    },
    {
      "label": "Mobile Expo 8081",
      "type": "shell",
      "command": "$env:REACT_NATIVE_PACKAGER_HOSTNAME='10.178.158.25'; npx expo start --lan",
      "options": { "cwd": "${workspaceFolder}/apps/mobile" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "digi" }
    },
    {
      "label": "Start Digi Gold",
      "dependsOn": ["API 8000", "Console 5174", "CRM 5173", "Website 5175", "Mobile Expo 8081"],
      "problemMatcher": [],
      "runOptions": { "runOn": "folderOpen" }
    }
  ]
}
